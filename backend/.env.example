# Local API settings
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Exact frontend origins allowed to read API responses, separated by commas.
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Leave blank until we configure the Shop Manager Atlas Free/M0 cluster.
# Put real credentials only in backend/.env, never in frontend code.
MONGODB_URI=
MONGODB_DB_NAME=repair_shop_manager

